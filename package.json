{
  "name": "ai-session-summary",
  "version": "0.1.0",
  "private": true,
  "description": "A local AI session journal for Codex, Claude Code and Doubao.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build && esbuild electron/main.ts electron/preload.ts electron/doubao-preload.ts --bundle --platform=node --outdir=dist-electron --external:electron --format=cjs --sourcemap",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "44.4.3",
    "esbuild": "^0.25.4",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.511.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "cross-env": "^7.0.3",
    "typescript": "^5.8.3",
    "vitest": "5.0.1"
  }
}
